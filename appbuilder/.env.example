# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# The easiest way to populate the Adobe I/O Runtime values is: `aio app use`
# (select your Org > Project > Workspace in the Adobe Developer Console).

## Adobe I/O Runtime credentials (required for `aio app run` / `deploy`)
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=https://adobeioruntime.net

## Action secrets (required by specific actions in app.config.yaml)
# Shared secret the JSON2HTML worker sends as the `x-api-key` header to the team-proxy action.
SERVICE_API_KEY=
CRM_API_TOKEN=
SLACK_WEBHOOK_URL=
